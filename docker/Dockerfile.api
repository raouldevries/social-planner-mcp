# ============================================
# Social Planner - API Dockerfile
# Multi-stage build for production
# ============================================

# Stage 1: Build dependencies and compile TypeScript
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies for native modules (bcrypt)
RUN apk add --no-cache python3 make g++

# Copy package files
COPY package*.json ./
COPY turbo.json ./
COPY tsconfig.base.json ./

# Copy workspace package files
COPY apps/api/package*.json ./apps/api/
COPY packages/database/package*.json ./packages/database/
COPY packages/shared/package*.json ./packages/shared/

# Copy prisma schema (needed for postinstall prisma generate)
COPY packages/database/prisma ./packages/database/prisma

# Install all dependencies
RUN npm ci

# Copy source code
COPY apps/api ./apps/api
COPY packages/database ./packages/database
COPY packages/shared ./packages/shared

# Generate Prisma client
RUN npx prisma generate --schema=packages/database/prisma/schema.prisma

# Clean TypeScript build cache to ensure fresh builds
RUN find . -name "tsconfig.tsbuildinfo" -delete

# Build all packages (--force to bypass Turbo cache)
RUN npx turbo build --filter=@social-planner/api... --force

# Stage 2: Production image
FROM node:20-alpine AS production

WORKDIR /app

# Install dependencies for native modules, OpenSSL for Prisma, and FFmpeg for video thumbnails
RUN apk add --no-cache python3 make g++ openssl openssl-dev ffmpeg

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S planner -u 1001

# Copy package files
COPY package*.json ./
COPY turbo.json ./

# Copy workspace package files
COPY apps/api/package*.json ./apps/api/
COPY packages/database/package*.json ./packages/database/
COPY packages/shared/package*.json ./packages/shared/

# Copy prisma schema (needed for postinstall prisma generate)
COPY --from=builder /app/packages/database/prisma ./packages/database/prisma

# Install production dependencies
# MCP SDK is now in root package.json to ensure it's installed at root level
RUN npm ci --omit=dev

# Copy Prisma client from builder (platform-specific binary)
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

# Copy built artifacts from builder
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/packages/database/dist ./packages/database/dist
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist

# Set ownership
RUN chown -R planner:nodejs /app

# Switch to non-root user
USER planner

# Expose port
EXPOSE 4000

# Health check (use 127.0.0.1 to avoid IPv6 issues)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:4000/health || exit 1

# Start the application
CMD ["node", "apps/api/dist/server.js"]
