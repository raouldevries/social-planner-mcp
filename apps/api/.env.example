# Social Planner API - Environment Variables

# Environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/planner?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-here-for-security
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-here-for-security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3/MinIO Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=planner-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# OAuth - Google (for user authentication)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# OAuth - Microsoft (for user authentication)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# OAuth - Instagram (for social account connection)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/social/instagram/callback

# OAuth - LinkedIn (for social account connection)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/social/linkedin/callback

# Email - Resend SDK (production, better Outlook deliverability)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Email - SMTP fallback (MailHog for local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=planner@planner.app

# Frontend URL
FRONTEND_URL=http://localhost:5173

# MCP (Model Context Protocol) Integration
# Enable/disable MCP feature (default: true)
MCP_ENABLED=true
# Token expiration settings
MCP_ACCESS_TOKEN_EXPIRES_IN=1h
MCP_REFRESH_TOKEN_EXPIRES_IN=30d
# Pending action expiration (user approval window)
MCP_PENDING_ACTION_EXPIRES_IN=24h
# Rate limiting (requests per minute)
MCP_RATE_LIMIT_REQUESTS=100
# Audit log retention (days)
MCP_AUDIT_RETENTION_DAYS=90
