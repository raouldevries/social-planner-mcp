# ============================================
# Social Planner - Production Environment
# ============================================
# Copy this file to .env on your production server
# and fill in all values before running docker compose

# ==========================================
# Domain Configuration
# ==========================================
# Your main domain (without protocol)
DOMAIN=planner.planner.nl

# Email for Let's Encrypt SSL certificates
ACME_EMAIL=admin@planner.nl

# Traefik dashboard authentication (generate with: htpasswd -nb admin password)
# Format: username:password_hash
TRAEFIK_AUTH=admin:$$apr1$$xxxxx

# ==========================================
# Database
# ==========================================
DB_USER=planner
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=planner_prod

# ==========================================
# Redis
# ==========================================
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ==========================================
# JWT Authentication
# ==========================================
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=CHANGE_ME_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_CHAR_HEX_STRING

# ==========================================
# Object Storage (MinIO)
# ==========================================
S3_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS
S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET
S3_BUCKET=planner-media
S3_REGION=eu-west-1
# Public URL for media files (must match the Traefik-exposed MinIO domain)
S3_PUBLIC_URL=https://storage.${DOMAIN}

# ==========================================
# Email Configuration
# ==========================================
# Option 1: SMTP (e.g., Mailgun, SendGrid, AWS SES)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.planner.nl
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD

# Option 2: Resend (recommended - easier setup)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# ==========================================
# OAuth Providers (Optional)
# ==========================================
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ==========================================
# Social Media APIs
# ==========================================
# Instagram Business API
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://planner.planner.nl/accounts?platform=INSTAGRAM

# LinkedIn API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://planner.planner.nl/accounts?platform=LINKEDIN

# ==========================================
# MCP (Model Context Protocol) Integration
# ==========================================
# Enable/disable MCP AI assistant integration
MCP_ENABLED=true
# Token expiration settings
MCP_ACCESS_TOKEN_EXPIRES_IN=1h
MCP_REFRESH_TOKEN_EXPIRES_IN=30d
# Pending action expiration (user approval window)
MCP_PENDING_ACTION_EXPIRES_IN=24h
# Rate limiting (requests per minute)
MCP_RATE_LIMIT_REQUESTS=100
# Audit log retention (days)
MCP_AUDIT_RETENTION_DAYS=90

# ==========================================
# Production Checklist
# ==========================================
# Before deploying, ensure you have:
# [ ] Changed all CHANGE_ME values
# [ ] Generated strong random passwords
# [ ] Set up DNS records:
#     - A record: planner.planner.nl -> your-server-ip
#     - A record: api.planner.planner.nl -> your-server-ip
#     - A record: storage.planner.planner.nl -> your-server-ip
# [ ] Configured firewall (allow 80, 443)
# [ ] Set up automated backups for postgres_data volume
