# ===========================================
# Social Planner - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Database
DATABASE_URL="postgresql://planner:planner_dev@localhost:5432/planner_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# MinIO / S3 Storage
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="planner-media"
S3_REGION="us-east-1"
# Optional: public URL for media files (falls back to S3_ENDPOINT in development)
# S3_PUBLIC_URL="http://localhost:9000"

# Email (MailHog for development, Resend for production)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=

# Application
NODE_ENV="development"
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
API_PORT="3001"

# Social Media APIs
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI="http://localhost:3000/accounts?platform=INSTAGRAM"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI="http://localhost:3000/accounts?platform=LINKEDIN"

# MCP (Model Context Protocol) Integration
# Enable MCP endpoint for Claude Desktop integration
MCP_ENABLED=true
MCP_ACCESS_TOKEN_EXPIRES_IN=1h
MCP_REFRESH_TOKEN_EXPIRES_IN=30d
MCP_PENDING_ACTION_EXPIRES_IN=24h
MCP_RATE_LIMIT_REQUESTS=100
MCP_AUDIT_RETENTION_DAYS=90

# External MCP Server Configuration (optional, for Claude Code)
CONTEXT7_API_KEY=
FIGMA_ACCESS_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
